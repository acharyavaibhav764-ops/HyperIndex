+"""v5.9 WP4: Page text-coverage safety net.
+
+Compares each page's PyMuPDF text layer against the cleaned markdown.
+
+Entry point
+    check_page(page_md, raw_text, running_lines, toc_page, ...) -> str
+Called from
+    parsers/pdf_router.py inside _merge_pages(), per page, after clean_page_markdown.
+
+Exclusions (never re-added)
+    - Lines in running_lines (boilerplate from strip_running_lines).
+    - Lines where is_noise_paragraph() is True.
+    - If toc_page=True: skip entire page.
+    - Lines matching figure-label pattern.
+"""
+from __future__ import annotations
+
+import logging
+import re
+from difflib import SequenceMatcher
+
+logger = logging.getLogger(__name__)
+
+_NORM_RE = re.compile(r"[\s\W]+")
+_FIGURE_LABEL_RE = re.compile(r"^(?:[A-Z]{1,6}\s*\d*|Fig\.?\s*\d+|Figure\s*\d+)$", re.I)
+_INSTRUCTION_RE = re.compile(r"^\d+[\.)\s]|^[A-Z][a-z]+ the |^Press\b|^Turn\b|^Insert\b|^Remove\b", re.I)
+
+
+def _norm(text: str) -> str:
+    return _NORM_RE.sub(" ", text.lower()).strip()
+
+
+def _is_figure_label(line: str) -> bool:
+    return bool(_FIGURE_LABEL_RE.match(line.strip())) and len(line.strip()) < 40
+
+
+def check_page(
+    page_md: str,
+    raw_text: str,
+    running_lines: set[str],
+    *,
+    toc_page: bool = False,
+    recall_min: float = 0.9,
+    near_match_ratio: float = 0.75,
+) -> str:
+    """Check coverage and repair/append uncovered text for one page.
+
+    Args:
+        page_md:          Cleaned markdown for this page.
+        raw_text:         Raw PyMuPDF text (page.get_text()).
+        running_lines:    Boilerplate strings from strip_running_lines.
+        toc_page:         If True, skip this page entirely.
+        recall_min:       Warn when recall drops below this.
+        near_match_ratio: difflib ratio threshold for in-place repair.
+
+    Returns:
+        Modified page_md with near-match repairs and optional recovered-text block.
+    """
+    if toc_page or not raw_text.strip():
+        return page_md
+
+    raw_lines = [ln.strip() for ln in raw_text.splitlines() if ln.strip()]
+    if not raw_lines:
+        return page_md
+
+    md_norm = _norm(page_md)
+    norm_running = {_norm(r) for r in running_lines}
+    covered: list[bool] = []
+    uncovered: list[str] = []
+    repaired = page_md
+
+    for raw_line in raw_lines:
+        n_raw = _norm(raw_line)
+        if not n_raw or n_raw in norm_running or _is_figure_label(raw_line):
+            covered.append(True)
+            continue
+        try:
+            from parsers.pdf_cleanup import is_noise_paragraph
+            if is_noise_paragraph(raw_line):
+                covered.append(True)
+                continue
+        except ImportError:
+            pass
+
+        if n_raw in md_norm:
+            covered.append(True)
+            continue
+
+        ratio = SequenceMatcher(None, n_raw, md_norm, autojunk=False).ratio()
+        if ratio >= near_match_ratio:
+            repaired = _repair_in_place(repaired, raw_line, near_match_ratio)
+            covered.append(True)
+            continue
+
+        covered.append(False)
+        uncovered.append(raw_line)
+
+    total = len(covered)
+    n_cov = sum(covered)
+    recall = n_cov / total if total else 1.0
+
+    if recall < recall_min:
+        logger.warning(
+            "coverage: recall=%.2f < %.2f -- %d/%d lines uncovered",
+            recall, recall_min, total - n_cov, total,
+        )
+
+    if uncovered:
+        repaired = repaired.rstrip() + "\n\n[Recovered text]\n" + "\n".join(uncovered)
+
+    return repaired
+
+
+def _repair_in_place(md: str, raw_line: str, ratio_threshold: float) -> str:
+    n_raw = _norm(raw_line)
+    lines = md.split("\n")
+    best_idx, best_ratio = -1, ratio_threshold - 0.01
+    for i, line in enumerate(lines):
+        n_line = _norm(line)
+        if not n_line:
+            continue
+        r = SequenceMatcher(None, n_raw, n_line, autojunk=False).ratio()
+        if r > best_ratio:
+            best_ratio, best_idx = r, i
+    if best_idx >= 0:
+        lines[best_idx] = raw_line
+        return "\n".join(lines)
+    return md
+

