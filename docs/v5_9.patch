diff -ruN a/tests/parsing_arch/v5_9/verify_v5_9.py b/tests/parsing_arch/v5_9/verify_v5_9.py
--- a/tests/parsing_arch/v5_9/verify_v5_9.py	1970-01-01 00:00:00.000000000 +0000
