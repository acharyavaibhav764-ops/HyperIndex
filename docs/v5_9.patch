+def _flatten_meta(meta: dict[str, Any]) -> dict[str, Any]:
+    """Convert list/None metadata values to Chroma-safe scalars.
+
+    chromadb==0.5.15 only accepts str/int/float/bool metadata values.
+    - ``page_numbers: list[int]`` -> comma-joined str ("" when empty).
+    - ``heading_path: list[str]`` -> " > " joined str ("" when empty).
+    - ``page: None`` -> key omitted.
+    All other values are passed through unchanged.
+    """
+    out: dict[str, Any] = {}
+    for k, v in meta.items():
+        if k == "page" and v is None:
+            continue                         # omit — Chroma rejects None
+        elif k == "page_numbers" and isinstance(v, (list, tuple)):
+            out[k] = ",".join(str(p) for p in v)
+        elif k == "heading_path" and isinstance(v, (list, tuple)):
+            out[k] = " > ".join(str(h) for h in v)
+        else:
+            out[k] = v
+    return out
+
