+def is_micro_label(text: str) -> bool:
+    """One short line of <= 3 words with no digits (a running logo such as 'Calisthenics Family')."""
+    t = text.strip()
+    return "\n" not in t and len(t) < 40 and len(t.split()) <= 3 and not re.search(r"\d", t)
+
