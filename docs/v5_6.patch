+
+def _heading_level(text: str, current: int | None) -> int:
+    """Return the chunker heading level (>=1) for a heading.
+
+    Numbered headings derive level from numbering depth; unnumbered headings keep
+    their existing SectionHeader level, defaulting to 1 (never 0: level 0 is the
+    document-title slot in HierarchicalChunker and is only cleared by another title).
+    """
+    if _NUMBERED_HEADING_RE.match(text):
